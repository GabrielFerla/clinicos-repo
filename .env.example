# ClinicOS — variáveis de ambiente de exemplo.
#
# Copie para `.env` (que está no .gitignore) e ajuste os valores.
# Em Docker, o `docker-compose.yml` já injeta as variáveis principais;
# este arquivo é útil para rodar `manage.py` no host (fora do container)
# e como referência completa de tudo que `config/settings/base.py` lê.

# ============ Django ============
# Gere uma chave nova em prod com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ============ Banco de dados (URL preferida) ============
# Formato: oracle://user:password@host:port/?service_name=PDB
DATABASE_URL=oracle://clinicos:oracle@oracle:1521/?service_name=FREEPDB1

# ============ Cache / Celery ============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Opcional — default = CELERY_BROKER_URL
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============ Email ============
# Opção A: EMAIL_URL (smtp://user:password@host:port). Se definida, sobrescreve
# os demais EMAIL_*.
# EMAIL_URL=smtp://user:pass@smtp.exemplo.com:587/?tls=True
#
# Opção B: variáveis individuais (default em dev, com Mailhog).
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@clinicos.local

# ============ Chatbot: LLM e embeddings ============
# O MVP1 roda LLM local via Ollama (sem chave de API, sem custo por token).
# De dentro do container, o host é alcançado por `host.docker.internal` — o
# `docker-compose.yml` já injeta `extra_hosts` para isso. Fora do container,
# troque por `http://localhost:11434`.
#
# ATENÇÃO ao modelo: use um SEM "thinking". Modelos qwen3 raciocinam antes de
# responder e isso não desliga pela API — o resultado é de 8 a 45 segundos de
# tela em branco, ou o raciocínio em inglês vazando como resposta.
# Ver docs/CHAT_MVP.md §4.2.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SEGUNDOS=120
LLM_MAX_TOOL_ITERACOES=2

# `all-minilm` produz 384 dimensões — mesmo tamanho decidido no ADR-0004.
# EMBEDDING_DIM tem que bater com a dimensão da coluna FAQ_VECTOR.EMBEDDING;
# mudar só aqui devolve resultado errado sem erro nenhum.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIM=384

CHAT_STREAM_MAX_SEGUNDOS=120
CHAT_HISTORICO_MAX_TURNOS=6

# ============ Cripto (LGPD) ============
# Gere ambos com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NUNCA reutilize chaves entre ambientes. Em prod, use secret manager.
CPF_ENCRYPTION_KEY=
CPF_HASH_PEPPER=
