{
  "name": "theme",
  "version": "1.0.0",
  "description": "Tailwind CSS para o ClinicOS (app apps.theme).",
  "private": true,
  "scripts": {
    "build": "npm run build:tailwind",
    "build:tailwind": "tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}
